<template name="template_menutab">

	<defaultTemplateVar name="$label" equals="0" />
	<defaultTemplateVar name="$spriteName" equals="'shop_tab_blueprints'" />
	<defaultTemplateVar name="$sheetName" equals="'xml_resources/rp_menu.xml'" />
	<defaultTemplateVar name="$tabWidth" equals="screenWidth()*0.05" />
	<defaultTemplateVar name="$tabHeight" equals="screenHeight()*0.22" />
	<defaultTemplateVar name="$layer" equals="'TABS'" />
	<defaultTemplateVar name="$touchHeight" equals="50" />
	
	<size dependentOnElement="element:name()" dependentOnComponent="bg" />
	
	<event name="show" params="element">
		element["bg"]("visible"):SetInt(1)
		element["Icon"]("visible"):SetInt(1)
		element["Touch"]("enabled"):SetInt(1)
	</event>
	<event name="hide" params="element">
		element["bg"]("visible"):SetInt(0)
		element["Icon"]("visible"):SetInt(0)
		element["Touch"]("enabled"):SetInt(0)
	</event>
	
	<ninesliceComponent name="bg">
		<event name="onInit" params="component, element">
				
				component("includeBorder"):SetInt(1)
				
				component("width"):SetFloat( $tabWidth );
				component("height"):SetFloat( $tabHeight );
				
				component("topHeight"):SetFloat( 16 );
				component("bottomHeight"):SetFloat( 16 );
				component("leftWidth"):SetFloat( 16 );
				component("rightWidth"):SetFloat( 16);
				
				component("spriteName"):Set("gfx/menu/popup_bg")
				
				component("layer"):SetString("$layer")
				
				
			</event>
	</ninesliceComponent>
	
	<spriteSheetComponent name="Icon">
		<position relativeTo="element:name()" vAnchor="TOP" hAnchor="RIGHT" />
		<orientation vAnchor="TOP" hAnchor="HCENTER" xOffset="0" yOffset="2" priorityOffset="-1" />
		<event name="onInit" params="component, element">
			component("spriteName"):SetString("$spriteName")
			component("sheetName"):SetString("$sheetName")
			component("layer"):SetString("$layer")
		</event>
	</spriteSheetComponent>
	
	<touchComponent name="Touch">
		<size w="50" h="50" />
		<position relativeTo="element:name()" vAnchor="TOP" hAnchor="LEFT" />
		<orientation vAnchor="TOP" hAnchor="LEFT" xOffset="0" yOffset="0" priorityOffset="0" />
		<event name="onInit" params="component, element">
			component:setSize(Vector2(50, $touchHeight ))
			--[[print("tab touched")]]
			component("layer"):SetString("$layer")
		</event>
	</touchComponent>
		
	<!--<textComponent name="Label">
		<position relativeTo="element:name()" vAnchor="TOP" hAnchor="HCENTER" />
		<orientation vAnchor="BOTTOM" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="0" />
		<event name="onInit" params="component, element">
			component("font"):Set("rp_font_title")	
			component("alignment"):SetInt(lua_sys.MenuTextComponent_TEXT_LEFT_ALIGNED)
			
			component("text"):SetString("$label")
			
			component("red"):SetFloat(1.0)
			component("green"):SetFloat(1.0)
			component("blue"):SetFloat(1.0)
			
			component("layer"):SetString("TABS")
		</event>
	</textComponent>-->
	
</template>