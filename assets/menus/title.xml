<menu>
	<element name="topElement">
		<size dependentOnElement="element:name()"/>
		
		<element name="bg">
			<size dependentOnElement="element:name()" dependentOnComponent="Sprite" />
			<position relativeTo="SCREEN" vAnchor="VCENTER" hAnchor="HCENTER" />
			<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priority="20" />
			<event name="enableMe" params="element">
				element["Sprite"]("visible"):SetInt(1)
				element["Touch"]("enabled"):SetInt(1)
			</event>
			<event name="disableMe" params="element">
				element["Sprite"]("visible"):SetInt(0)
				element["Touch"]("enabled"):SetInt(0)
			</event>
			<ninesliceComponent name="Sprite">
				<event name="onInit" params="component, element" >
					component("spriteName"):Set("gfx/menu/menu_overlay")
					component("width"):SetFloat( screenWidth() );
					component("height"):SetFloat( screenHeight() );
					component("layer"):SetString("HUD");
				</event>
			</ninesliceComponent>
			<touchComponent name="Touch">
				<size dependentOnElement="element:name()"/>
				<event name="onTouchUp" params="component, element">					
				</event>
			</touchComponent>
		</element>
		
		<element name="TitleImg">
			<size dependentOnElement="element:name()" dependentOnComponent="Sprite"/>
			<position relativeTo="SCREEN" vAnchor="VCENTER" hAnchor="HCENTER" />
			<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="-screenHeight()/16" priority="3" />
			
			<spriteComponent name="Sprite">
				<event name="onInit" params="component, element">
					component("spriteName"):Set("gfx/menu/title_raft_pirates")
					component("layer"):SetString("HUD");
					lua_sys.playMP3("audio/music/theme")
				</event>
			</spriteComponent>
			
			<touchComponent name="Touch">
				<size dependentOnElement="element:name()"/>
			</touchComponent>
		</element>
		
		<element name="version">
			<textComponent name="Text" >
				<position relativeTo="SCREEN" vAnchor="BOTTOM" hAnchor="HCENTER" />
				<orientation vAnchor="BOTTOM" hAnchor="HCENTER" xOffset="0" yOffset="0" priority="2" />
				<event name="onInit" params="component, element" >
					component("font"):Set("rp_font_title")
					component("size"):Set(0.5)
					component("alignment"):SetInt(lua_sys.MenuTextComponent_TEXT_HCENTER_ALIGNED)					
					component("red"):SetFloat(0.988)
					component("green"):SetFloat(0.991)
					component("blue"):SetFloat(0.129)
					component("text"):SetString(game.versionNumber() .. "   (BBB ID: ".. game.getPlayerBBBId() .. ")" )
					print ("Version info: "..component("text"):GetString())
					component("layer"):SetString("HUD");
				</event>
			</textComponent>
		</element>
		
		<template type="HudButton" name="Start">
			<position relativeTo="element:parent()[&quot;version&quot;][&quot;Text&quot;]" vAnchor="TOP" hAnchor="HCENTER" />
			<orientation vAnchor="BOTTOM" hAnchor="HCENTER" xOffset="0" yOffset="0" priority="-1" />
		
			<templateVar name="$image" equals="btn_set_sail" />
			<templateVar name="$sheet" equals="rp_menu" />
		
			<textComponent name="Text" >
				<position relativeTo="element:name()" vAnchor="VCENTER" hAnchor="HCENTER" />
				<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priority="-1" />
				<event name="onInit" params="component, element" >
					component("multiline"):SetInt(0)
					component("font"):Set("rp_font_title")
					component("size"):Set(1.0)
					component("alignment"):SetInt(lua_sys.MenuTextComponent_TEXT_HCENTER_ALIGNED)
					
					component("red"):SetFloat(0.988)
					component("green"):SetFloat(0.991)
					component("blue"):SetFloat(0.129)
					
					component("text"):SetString("OPENING_SCREEN")
					
					component("layer"):SetString("HUD");
					
					component("autoScale"):SetInt(1)
					
				</event>
				<event name="onPostSolve" params="component, element" >
					component:setSize(Vector2(element["UpSprite"]("width"):GetInt()-4*deviceScaleX(), 0))
				</event>
				
			</textComponent>
			<touchComponent name="Touch">
				<size dependentOnElement="element:name()"/>
				<event name="onTouchUp" params="component, element">
					onTouchUp(component, element)
					game.engineReceiver():Send( game.MsgTransitionDone( false ) );
				</event>
			</touchComponent>
		</template>
		
	</element>		
</menu>