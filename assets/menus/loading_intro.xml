 <menu>
	
	<element name="LoadGraphic">
	
		<size dependentOnElement="element:name()" dependentOnComponent="Anim" />
		<position relativeTo="SCREEN" vAnchor="VCENTER" hAnchor="HCENTER" />
		<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priority="100" />
	
		<event name="onInit" params="element">			
			element:SetupGenericListener(game.engineReceiver(),  "rp::MsgLoadPreStart", "onLoadPreStart")
			element:SetupGenericListener(game.engineReceiver(),  "rp::MsgLoadStart", "onLoadStart")
			element:SetupGenericListener(game.engineReceiver(),  "rp::MsgLoadPercentage", "onLoadPercentChanged")
			element:SetupGenericListener(game.engineReceiver(),  "rp::MsgLoadFinished", "onLoadFinished")			
		</event>

		<event name="onLoadPreStart" params="element, msg">
			print("OnLoadPreStart")	
			element["Anim"]("animation"):SetString("idle")
		</event>
		
		<event name="onLoadStart" params="element, msg">
			print("loading_intro: OnLoadStart")	
		</event>
	
		<event name="onLoadPercentChanged" params="element, msg">
			print("loading_intro: onLoadPercentChanged")
		</event>
	
		<event name="onLoadFinished" params="element, msg">
			print("loading_intro: onLoadFinished")
			element["Anim"]("animation"):SetString("outro")
		</event>
	
	
		<aeComponent name="Anim">
			<position relativeTo="element:name()" vAnchor="VCENTER" hAnchor="HCENTER" />
			<orientation vAnchor="TOP" hAnchor="LEFT" xOffset="0" yOffset="0" priority="0" />
			<event name="onInit" params="component, element">
				component("animationName"):Set("xml_bin/anim_loading_curtains.bin")
				print("setting intro anim")
        component("animation"):SetString("intro")
				component("layer"):SetString("LOADING")
			</event>
			
			<event name="onAnimationFinished" params="component, element">
				
				local anim = component("animation"):GetString()
				if ( anim == "intro" ) then
					print("setting intro anim")
					
					component("animation"):SetString("idle")
					if( game.lastLoginType() == 0 ) then
						component("animation"):SetString("idle 2")
						menu:pushPopUp("login_menu")
					elseif (game.lastLoginType() == 3 ) then
						if( game.lastLoginUsername() ~= "") then
							game.authWithEmail(game.lastLoginUsername(), game.lastLoginPassword())
						else
							menu:pushPopUp("login_menu")
						end
					elseif (game.lastLoginType() == 1 ) then
						game.authWithGameCenter()
					elseif (game.lastLoginType() == 2 ) then
						game.authWithFacebook()
					else
						menu:pushPopUp("login_menu")
					end
				elseif ( anim == "outro" ) then
					game.engineReceiver():Send( game.MsgLoadingAnimFinished() )	
				end
				
				
			</event>
			
		</aeComponent>
	
	
	
	</element>
 
 
 </menu>